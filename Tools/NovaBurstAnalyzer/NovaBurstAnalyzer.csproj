<Project Sdk="Microsoft.NET.Sdk">

  <!--
    [BurstCompile] HPC# 규칙 분석기 (Unity Burst 의 컴파일 오류 BC10xx 에 해당 — NOVA 는 NB1xxx 경고).
    에디터가 만드는 Assembly-CSharp.csproj 가 <Analyzer> 로 참조한다 → 스크립트 컴파일 때 Console 에 경고.
    빌드: CMake (NovaBurstAnalyzer 대상) 가 Binaries/Scripting/Analyzers 에 출력한다.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>NovaBurstAnalyzer</AssemblyName>
    <RootNamespace>NovaEngine.Burst.Analyzers</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- 릴리스 추적 (RS2008) · 변수로 넘긴 규칙 (RS1005 — 모두 SupportedDiagnostics 에 있다) -->
    <NoWarn>$(NoWarn);RS2008;RS1005</NoWarn>
    <OutputPath>..\..\Binaries\Scripting\Analyzers\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
